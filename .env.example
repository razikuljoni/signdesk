# ==============================================================================
# SignDesk — Environment Configuration Template
# ==============================================================================
# Copy this file to .env before starting the application:
#   cp .env.example .env
#
# Free Tier Constraints (§14):
# - Resend daily cap is 100 emails/day
# - Default monthly envelope limit on free tier is 5 envelopes/month
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Application Runtime
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ------------------------------------------------------------------------------
# 2. Database (PostgreSQL 16+)
# ------------------------------------------------------------------------------
# Format: postgresql://[user]:[password]@[host]:[port]/[database]?schema=public
DATABASE_URL="postgresql://signdesk:signdesk_dev_secret@localhost:5432/signdesk?schema=public"

# ------------------------------------------------------------------------------
# 3. Redis Cache & BullMQ Queues (Redis 7+)
# ------------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# 4. Authentication & Security
# ------------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
JWT_SECRET="replace_with_a_secure_random_32_character_string_for_production"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# 5. Transactional Email Delivery (SMTP / MailHog / Resend)
# ------------------------------------------------------------------------------
# Local dev: MailHog (host: localhost, port: 1025)
# Production: Resend SMTP (host: smtp.resend.com, port: 465 or 587, user: resend, pass: re_...)
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM_NAME="SignDesk Notifications"
MAIL_FROM_EMAIL="no-reply@signdesk.bd"

# ------------------------------------------------------------------------------
# 6. S3-Compatible Object Storage (MinIO / Cloudflare R2 / AWS S3)
# ------------------------------------------------------------------------------
S3_ENDPOINT="http://localhost:9000"
S3_REGION="auto"
S3_BUCKET="signdesk-documents"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_FORCE_PATH_STYLE=true

# ------------------------------------------------------------------------------
# 7. AI Plain-Language Summarization (Google Gemini API — Optional)
# ------------------------------------------------------------------------------
# Get key from: https://aistudio.google.com/
# Falls back gracefully to "scanned document / summary unavailable" if omitted.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
